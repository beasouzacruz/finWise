
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Ciclo {
  id          Int          @id @default(autoincrement())
  titulo      String
  mes         String
  ano         String
  lancamentos Lancamento[]
  createdAt   DateTime     @default(now())
}

model Lancamento {
  id          Int      @id @default(autoincrement())
  descricao   String
  valor       Float
  status      String
  tipo        String
  categoria   String   @default("Outros")
  cicloId     Int
  ciclo       Ciclo    @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
